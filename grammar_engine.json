  "patterns": {
    "thirdPersonSubject": "(he|she|it|my (?:friend|brother|sister|father|mother|teacher|boss|husband|wife|son|daughter))",
    "thirdPersonVerbs": "go|do|have|be|like|want|need|make|take|come|say|get|know|think|work|live|play|speak|watch|study|eat|drink|write|read|run|give|feel|look|find|use|try|ask|call|tell|help|start|talk|walk|move|turn|learn|teach|buy|pay|open|close|keep|stay|leave|love|hate|prefer|drive|cook|clean|travel|arrive|finish|listen",
